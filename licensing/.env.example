# =============================================================================
# cassyx licensing service - environment template  (plan sections 9.1, 9.3, 9.4)
#
#   cp licensing/.env.example licensing/.env    # licensing/.env is gitignored
#
# This file is SEPARATE from the repository-root .env.example on purpose: these are the operator's
# secrets, and none of them may ever reach a customer's machine. In particular the private key
# below is the whole security model - anyone holding it can mint licences for free, forever.
#
# Every value here is a PLACEHOLDER. Never commit a real one.
# =============================================================================

# --- Ed25519 key pair --------------------------------------------------------
# Generate both halves - see "1. Generate a key pair" in licensing/README.md:
#   docker run --rm -v "$PWD":/w -v "$HOME/.m2":/root/.m2 -w /w/licensing \
#     maven:3.9-eclipse-temurin-21 mvn -q exec:java
#
# PRIVATE half - stays HERE and only here.
CASSYX_LICENSING_PRIVATE_KEY=PLACEHOLDER
# PUBLIC half - also set here (every minted key is verified before it is emailed) AND shipped to
# the product as CASSYX_LICENSE_PUBLIC_KEY. Getting these two backwards publishes your private key.
CASSYX_LICENSE_PUBLIC_KEY=PLACEHOLDER

# --- Service ----------------------------------------------------------------
CASSYX_LICENSING_PORT=8090
# The H2 file is the only record of which payment produced which key. Back it up.
CASSYX_LICENSING_DB_PATH=./data/licensing
CASSYX_LICENSING_DB_USER=licensing
CASSYX_LICENSING_DB_PASSWORD=licensing
CASSYX_LOG_LEVEL=INFO

# Shared secret a cassyx instance sends as X-Cassyx-Licensing-Token when it forwards a fulfilment
# it verified itself. Leave it unset ONLY on a loopback dev instance: unset means the internal
# minting endpoints are unauthenticated, and the service logs a warning every time.
CASSYX_LICENSING_TOKEN=PLACEHOLDER

# --- Licence shape ----------------------------------------------------------
CASSYX_LICENSING_TRIAL_DAYS=14
CASSYX_LICENSING_SEATS=1
CASSYX_LICENSING_PAYLOAD_VERSION=1
# Purchased major version written into `scope` (plan section 9.5). 0 omits the field entirely,
# which means "valid for every version" - the backwards-compatible default. Set it to 1 only when
# you are ready for a future major to be a paid upgrade.
CASSYX_LICENSING_SCOPE=0

# --- Stripe ------------------------------------------------------------------
# No account needed for development:  npm i -g @stripe/cli && stripe sandbox create
# Use a RESTRICTED key (rk_), not a secret key (sk_).
STRIPE_SECRET_KEY=rk_test_PLACEHOLDER
# From `stripe listen --forward-to localhost:8090/licensing/webhook`, or the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
# Override only to point at a mock; the default is https://api.stripe.com.
CASSYX_BILLING_API_URL=https://api.stripe.com

# --- Email -------------------------------------------------------------------
# 'log'  - writes the whole email, licence key included, to the service log instead of sending it,
#          so the service runs end to end with no provider account. It logs at WARN precisely
#          because leaving it on in production means customers are silently not being emailed.
# 'smtp' - the real one. Every provider worth using (Postmark, SES, Resend, Mailgun, Fastmail,
#          Gmail) speaks SMTP, so switching provider is a change to the four SMTP_* values below
#          and nothing else.
# Anything else fails startup on purpose, rather than quietly falling back to 'log'.
CASSYX_LICENSING_EMAIL_PROVIDER=log

# MUST be on a domain you control and have authenticated (see below). A From address on a domain
# you do not control fails DMARC at the recipient and is dropped or spam-foldered.
CASSYX_LICENSING_EMAIL_FROM=licensing@cassyx.dev
CASSYX_LICENSING_EMAIL_FROM_NAME=cassyx
CASSYX_LICENSING_EMAIL_REPLY_TO=support@cassyx.dev
# The purchase subject. The trial and re-send subjects are derived from it, so a recovery is never
# indistinguishable from a new purchase in the buyer's inbox list.
CASSYX_LICENSING_EMAIL_SUBJECT=Your cassyx licence key
# Both optional. Blank omits the line from the email rather than printing a dead link.
CASSYX_LICENSING_PURCHASE_URL=
CASSYX_LICENSING_RECOVERY_URL=

# --- SMTP (only used when CASSYX_LICENSING_EMAIL_PROVIDER=smtp) ---------------
# Examples: smtp.postmarkapp.com:587 | email-smtp.eu-west-1.amazonaws.com:587
#           smtp.resend.com:587      | smtp.mailgun.org:587
CASSYX_LICENSING_SMTP_HOST=
CASSYX_LICENSING_SMTP_PORT=587
CASSYX_LICENSING_SMTP_USERNAME=
# Never logged by this service, and never echoed in an error. Keep it out of shell history too.
CASSYX_LICENSING_SMTP_PASSWORD=
# starttls  - port 587, what every provider documents. TLS is REQUIRED, not merely offered:
#             without that a downgrade sends the customer's licence key in clear text.
# ssl       - implicit TLS on port 465, for providers that still prefer it.
# none      - a local test server and nothing else. Never against a real provider.
CASSYX_LICENSING_SMTP_TLS=starttls
# Jakarta Mail defaults all three to INFINITE. These are not optional: a hung SMTP connection
# inside the Stripe webhook handler stalls fulfilment for every buyer behind it.
CASSYX_LICENSING_SMTP_CONNECT_TIMEOUT_MS=10000
CASSYX_LICENSING_SMTP_READ_TIMEOUT_MS=15000
CASSYX_LICENSING_SMTP_WRITE_TIMEOUT_MS=15000
# Bounded retries for transient failures only; a permanent one (bad credentials, rejected
# recipient) is never retried. Anything beyond this is POST /licensing/recover's job.
CASSYX_LICENSING_SMTP_MAX_ATTEMPTS=3
CASSYX_LICENSING_SMTP_RETRY_DELAY_MS=500
