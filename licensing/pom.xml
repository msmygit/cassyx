<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cassyx</groupId>
    <artifactId>cassyx-parent</artifactId>
    <version>1.0.1</version>
    <!-- The reactor lives in backend/; this module deliberately sits outside it. See the
         `licensing` profile in backend/pom.xml for why. -->
    <relativePath>../backend/pom.xml</relativePath>
  </parent>
  <artifactId>cassyx-licensing</artifactId>
  <name>cassyx-licensing</name>
  <description>Operator-run licence minting service. Holds the Ed25519 PRIVATE key; never shipped to customers.</description>

  <properties>
    <!-- ${project.parent.basedir} is NOT a resolvable Maven property: the parent's basedir is
         not exposed to a child model, so it survives interpolation as a literal and checkstyle
         dies with "Could not find resource '${project.parent.basedir}/config/checkstyle.xml'".
         The backend modules never hit this because they inherit the parent's own
         ${project.basedir} form and sit inside the reactor. This module deliberately sits
         outside backend/, so it has to spell the path out relative to itself. -->
    <checkstyle.config.path>${project.basedir}/../backend/config/checkstyle.xml</checkstyle.config.path>
    <!-- In-process SMTP server for the delivery tests. Version checked against OSV before pinning
         (`curl -s https://api.osv.dev/v1/query -d '{"package":{"name":"com.icegreen:greenmail",
         "ecosystem":"Maven"},"version":"2.1.12"}'` returns no vulnerabilities), because this repo
         fails the build at CVSS 7 and has a history of pins that looked fine and were not. -->
    <greenmail.version>2.1.12</greenmail.version>
  </properties>

  <dependencies>
    <!-- Reuses the licence payload model and the verifier: a minted key MUST verify with exactly
         the code the shipped product runs, so the round-trip test is meaningful (plan section 9.1). -->
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-license</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- SMTP delivery. Chosen over any vendor API SDK because every provider an operator might
         pick speaks SMTP, so switching provider is an env-var change; see SmtpLicenseEmailSender. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A real SMTP server in-process. Mocking JavaMailSender would prove a method was called, not
         that a message survives an SMTP conversation intact - which is the only thing that matters
         when the message IS the thing the customer paid for. -->
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail</artifactId>
      <version>${greenmail.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- GreenMail publishes junit 4 in COMPILE scope for its JUnit 4 rule, which we do not use.
             Left in, it would drag a second test framework onto the test classpath and into the
             CVE scan for no benefit. -->
        <exclusion>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Key generation is a one-off operator task, not an application entry point, so it runs
           through exec rather than being wired into the Spring context:
             mvn -f licensing/pom.xml exec:java -Dexec.mainClass=io.cassyx.licensing.mint.KeyPairTool -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>io.cassyx.licensing.mint.KeyPairTool</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
