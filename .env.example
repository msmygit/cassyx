# =============================================================================
# cassyx — committed example environment. Copied to .env automatically on the
# first `make up` / `./cassyx up`. Never commit a real .env (it is gitignored).
# =============================================================================

COMPOSE_PROJECT_NAME=cassyx

# ---------------------------------------------------------------------------
# Ports (host side). Change these if something already owns the port.
# ---------------------------------------------------------------------------
# The single origin you open in a browser: nginx serves the SPA and proxies
# /api -> backend. This is the URL `make up` opens.
CASSYX_WEB_PORT=8080
# Backend published directly (handy for curl / Swagger); not used by the SPA.
CASSYX_API_PORT=8081
# Vite dev server (`make dev`) with HMR.
CASSYX_VITE_PORT=5173
# Cassandra native protocol.
CASSANDRA_PORT=9042

# ---------------------------------------------------------------------------
# Cassandra 5.x (5.x is REQUIRED: vector<float,N> + SAI).
# ---------------------------------------------------------------------------
CASSANDRA_IMAGE=cassandra:5.0
CASSANDRA_CLUSTER_NAME=cassyx-dev
CASSANDRA_DC=datacenter1
CASSANDRA_RACK=rack1
CASSANDRA_HOST=cassandra
# Single-node dev heap. Raise for `make bench`.
CASSANDRA_MAX_HEAP=2G
CASSANDRA_HEAP_NEWSIZE=512M
# Default dev superuser (Cassandra's built-in PasswordAuthenticator defaults).
CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=cassandra

# ---------------------------------------------------------------------------
# Seed data (scripts/seed.cql + scripts/seed.sh). All row counts are scalable
# so `make bench` can re-seed at benchmark volume:
#   make seed SEED_SCALE=100
# ---------------------------------------------------------------------------
SEED_KEYSPACE=cassyx_demo
# Multiplies every row count below. 1 = fast dev seed (~seconds).
SEED_SCALE=1
# Rows in the "normal" event table (per scale unit).
SEED_EVENTS=2000
# Rows in the deliberately skewed partition (§5.2 work-stealing path).
SEED_SKEW_ROWS=20000
# Rows in the vector<float,1536> + SAI table.
SEED_VECTOR_ROWS=200
# Wide table for the grid benchmark (§11.2: first paint < 1s).
SEED_WIDE_COLUMNS=1000
SEED_WIDE_ROWS=200
# Vector dimension. 1536 per plan §2.2; do not lower without updating tests.
SEED_VECTOR_DIM=1536

# ---------------------------------------------------------------------------
# Backend (Spring Boot 3.5 / Java 21)
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker
# H2 file-mode store (connections, scripts, history, jobs, license).
CASSYX_DATA_DIR=/data
# AES-256-GCM key for credential-at-rest encryption (§3).
# DEV VALUE ONLY — generate your own: openssl rand -base64 32
CASSYX_SECRET_KEY=ZGV2LW9ubHktUExBQ0VIT0xERVIta2V5LTMyYnl0ZXM=
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# ---------------------------------------------------------------------------
# Licensing (§9.2). Two ways to run unlocked, and only one of them works everywhere:
#
#   1. A free signed SITE LICENCE (edition "site") in CASSYX_LICENSE_KEY. Issued on request for
#      CI, evaluation and enterprise self-hosting. Works in every build, including the published
#      Docker image. This is the supported way.
#   2. CASSYX_LICENSE_ENFORCE=false, the development bypass. It only has an effect in a build
#      made with the `dev` Maven profile (`make up` builds that). Release images are built with
#      `release`, which bakes cassyx.license.bypass-allowed=false: there the flag is IGNORED,
#      enforcement stays on, and a WARN naming this variable is logged at startup.
#
# The UI keeps the bypass banner visible so a bypassed instance is never mistaken for paid; a site
# licence is a granted licence and is badged as such instead.
# ---------------------------------------------------------------------------
CASSYX_LICENSE_ENFORCE=false
CASSYX_LICENSE_KEY=
CASSYX_LICENSE_PUBLIC_KEY=
# Maven profile baked into the backend image: `dev` keeps the bypass flag above working, `release`
# (the Dockerfile default) disables it. Do not set this to `dev` for anything you publish.
CASSYX_BYPASS_PROFILE=dev

# ---------------------------------------------------------------------------
# Billing (§9.3). Placeholders only — NEVER put live keys in this file.
# ---------------------------------------------------------------------------
CASSYX_BILLING_ENABLED=false
CASSYX_BILLING_API_URL=https://api.stripe.com
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
STRIPE_SECRET_KEY=rk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_ID=price_PLACEHOLDER
CASSYX_SUCCESS_URL=http://localhost:8080/activate?session_id={CHECKOUT_SESSION_ID}
CASSYX_CANCEL_URL=http://localhost:8080/pricing

# ---------------------------------------------------------------------------
# Toolchain images — everything builds/tests in containers, so a clean
# checkout needs ONLY Docker + Make. No local Java, Node or Maven.
# ---------------------------------------------------------------------------
MAVEN_IMAGE=maven:3.9-eclipse-temurin-21
NODE_IMAGE=node:22-bookworm
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.49.1-noble

# ---------------------------------------------------------------------------
# E2E / bench
# ---------------------------------------------------------------------------
# Base URL Playwright drives. Inside compose it is the nginx service.
E2E_BASE_URL=http://frontend:8080
BENCH_ROWS=1000000
BENCH_OUT_DIR=/work/bench-results
