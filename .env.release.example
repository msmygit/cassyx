# =============================================================================
# cassyx - environment for the RELEASE stack (docker-compose.release.yml).
#
# Save this as `.env` next to docker-compose.release.yml. It is the only file
# you need to edit. Do not commit it anywhere: it holds your encryption key.
#
# This is NOT .env.example - that one configures the development stack (source
# checkout, containerised toolchain, throwaway Cassandra, licensing bypassed).
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED - credential encryption
# ---------------------------------------------------------------------------
# AES-256-GCM key protecting the Cassandra/DSE/Astra credentials cassyx stores
# for you. There is deliberately no default: a shipped one would mean every
# install encrypts its passwords with a key anyone can read off GitHub.
#
# Generate yours (32 random bytes, base64):
#
#     openssl rand -base64 32
#
# Keep it. Changing it makes already-saved connections undecryptable.
CASSYX_SECRET_KEY=

# ---------------------------------------------------------------------------
# Licence (plan §9)
# ---------------------------------------------------------------------------
# Paste the key from your purchase email. Leave empty to run unlicensed: cassyx
# starts and shows the activation/purchase screen instead of the app.
CASSYX_LICENSE_KEY=

# Site-licence / air-gapped evaluation escape hatch (§9.2). `false` unlocks
# everything with no checks; the UI then shows a permanent bypass banner so a
# bypassed instance is never mistaken for a paid one.
CASSYX_LICENSE_ENFORCE=true

# ---------------------------------------------------------------------------
# Version
# ---------------------------------------------------------------------------
# Which published images to run. `latest` tracks the newest stable release;
# pin an exact version for anything you depend on, e.g. CASSYX_VERSION=1.0.0.
# A major bump may require a licence upgrade (§9.5) - your existing key keeps
# working on the major it was sold for, forever.
CASSYX_VERSION=latest

# Override only if you run images from a fork or an internal mirror.
CASSYX_IMAGE_OWNER=msmygit

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# The URL you open in a browser.
CASSYX_WEB_PORT=8080
# The API, published on loopback only for curl/Swagger. The UI does not use it.
CASSYX_API_PORT=8081
# Set to 0.0.0.0 to reach the API from another machine. Understand first that
# /api/health and /api/license are ungated by design (§9.1).
CASSYX_API_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Give the JVM more of the container's memory for large bulk jobs (§5.2/§5.3).
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# Change if you run more than one cassyx on the same Docker host.
COMPOSE_PROJECT_NAME=cassyx
