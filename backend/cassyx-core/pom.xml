<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cassyx</groupId>
    <artifactId>cassyx-parent</artifactId>
    <version>1.0.1</version>
  </parent>
  <artifactId>cassyx-core</artifactId>
  <name>cassyx-core</name>
  <description>Session registry, schema catalog, CQL execution, paging, Astra DevOps. Plain Java, no Spring.</description>

  <properties>
    <checkstyle.config.path>${project.parent.basedir}/config/checkstyle.xml</checkstyle.config.path>
    <!-- section 11.1 gate: 85% + mutation testing.
         Phase 1 workstream A has flipped the skip off: this module now carries the session
         registry, the AES-256-GCM cipher, the capability matrix and the SSH tunnel, and the gate
         is what stops that lot regressing. Do not put it back. -->
    <cassyx.coverage.line>0.85</cassyx.coverage.line>
    <cassyx.coverage.skip>false</cassyx.coverage.skip>
    <sshd.version>2.15.0</sshd.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.cassandra</groupId>
      <artifactId>java-driver-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Astra DevOps API JSON only. No Spring, no web framework (section 2.1). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- SSH local port forward before session build (plan section 3, "SSH tunnel support").
         Apache MINA sshd rather than JSch: JSch upstream is abandoned, and MINA ships an
         embeddable SERVER as well as a client, which is what lets MinaSshTunnel be covered by a
         real end-to-end test (MinaSshTunnelTest) instead of a mock. Still no Spring, no web layer. -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <version>${sshd.version}</version>
    </dependency>

    <!-- The shared Testcontainers singleton (section 11.2) lives in this module's test sources and
         is republished as a test-jar so every other module extends the SAME container. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>cassandra</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Driver-facing classes (session factory, capability probe, paging) are exercised against
         mocked driver interfaces so the 85% gate does not depend on Docker being present. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- section 11.1: PIT runs on core + bulk only, and never in the default build. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>pitest-mutation-coverage</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
