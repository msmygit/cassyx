<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cassyx</groupId>
    <artifactId>cassyx-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>cassyx-license</artifactId>
  <name>cassyx-license</name>
  <description>Ed25519 license verification and the PaymentProvider SPI. No driver, no Spring.</description>

  <properties>
    <checkstyle.config.path>${project.parent.basedir}/config/checkstyle.xml</checkstyle.config.path>
    <!-- section 11.1 gate -->
    <cassyx.coverage.line>0.90</cassyx.coverage.line>
    <!-- Enforced from here on: the module now carries real logic (verification, trials, scope, and
         the Stripe provider), so the Phase 0 blanket skip no longer applies. Measured 92.3% when
         this was switched on. Anything added here needs tests to match - that is the point. -->
    <cassyx.coverage.skip>false</cassyx.coverage.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Stripe SDK, pinned in the parent (33.2.0, API version 2026-07-29.dahlia). A compile
         dependency rather than optional, so cassyx-api and the licensing service inherit it without
         restating the pin. NoopPaymentProvider still loads none of it, which is exactly the point
         of the SPI: a reseller can drop in another processor and never touch a Stripe class. -->
    <dependency>
      <groupId>com.stripe</groupId>
      <artifactId>stripe-java</artifactId>
    </dependency>
  </dependencies>
</project>
