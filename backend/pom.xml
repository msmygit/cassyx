<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.cassyx</groupId>
  <artifactId>cassyx-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>cassyx-parent</name>
  <description>cassyx - Cassandra / DSE / Astra data manager. Maven multi-module parent.</description>

  <modules>
    <module>cassyx-core</module>
    <module>cassyx-bulk</module>
    <module>cassyx-vector</module>
    <module>cassyx-migrate</module>
    <module>cassyx-license</module>
    <module>cassyx-api</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- ===== version pins: docs/plan.md section 2 "Version pins" table ===== -->
    <!-- 3.5.16, not 3.5.4. The first complete Dependency-Check aggregate run surfaced 7 findings
         against spring-boot 3.5.4 (worst CVE-2026-40974, 9.8), 21 against the spring-core 6.2.9 it
         pulls (worst CVE-2026-41855, 9.8) and 30 against tomcat-embed-core 10.1.43 (worst
         CVE-2026-43512 / CVE-2026-41293, 9.8 each). One Boot bump clears spring-boot and
         spring-core outright: 3.5.16 manages spring-framework 6.2.19. Deliberately staying on the
         3.5.x maintenance line - 4.1.x is the current release line but a major-line jump is not
         this change. -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- Overrides the 10.1.55 Boot 3.5.16 manages. Applied via explicit <dependencyManagement>
         entries below, NOT by this property alone - see the comment there.

         10.1.55 was NOT clean: the scan still reported CVE-2026-55276, CVE-2026-53434,
         CVE-2026-59083, CVE-2026-59084 (9.1 each), CVE-2026-53404 (7.3) and CVE-2026-66299 (7.5).
         All but the last are fixed in 10.1.57.

         Worth recording why the earlier OSV check missed these: OSV carries no Maven range for any
         of them, so an OSV lookup reports the artifact clean. Dependency-Check matches CPEs against
         NVD, which does carry the ranges. The two sources disagree, and for a CVE gate NVD is the
         one that decides. Verify tomcat and friends against NVD directly, not OSV alone.

         CVE-2026-66299 is fixed only in 10.1.58, which is not on Maven Central yet. It does not
         apply to us and is suppressed with the evidence in dependency-check-suppressions.xml. -->
    <tomcat.version>10.1.57</tomcat.version>
    <java-driver.version>4.19.3</java-driver.version>
    <stripe.version>33.3.0</stripe.version>
    <dsbulk.version>1.11.2</dsbulk.version>

    <!-- ===== security pins: docs/plan.md section 2 "Security pin required" =====
         CVE-2026-24400 - org.assertj:assertj-core XXE in XmlStringPrettyFormatter
                          (vulnerable 1.4.0 .. 3.27.6, fixed in 3.27.7). Reachable through the
                          DSBulk 1.x dependency tree, which ships assertj on non-test scopes.
         CVE-2023-6378  - ch.qos.logback:logback-classic / logback-core deserialisation DoS in the
                          receiver component (vulnerable < 1.3.12 / < 1.4.12). DSBulk 1.11.x pulls
                          logback 1.2.x transitively.
         Both are pinned in <dependencyManagement> below so ANY module that later adds DSBulk
         inherits the safe versions. Do not lower these. OWASP Dependency-Check runs in CI. -->
    <assertj.version>3.27.7</assertj.version>
    <!-- 1.5.34 is the version Spring Boot 3.5.16 manages. This pin is a DIRECT
         <dependencyManagement> entry declared before the imported BOMs, so it wins outright - left
         at 1.5.18 it would have quietly held logback BELOW what Boot ships, and 1.5.18 carries four
         open advisories (CVE-2025-11226, CVE-2026-1225, CVE-2026-9828, CVE-2026-10532). Raising it
         in lockstep with the Boot bump keeps the CVE-2023-6378 floor and adds no drift. -->
    <logback.version>1.5.34</logback.version>
    <!-- Flagged by the weekly cve-scan against the versions Spring Boot and the Cassandra driver
         pull in. netty stays on its current minor line - a maintenance release, not an upgrade
         (Boot 3.5.16 manages 4.1.135.Final; 4.1.137.Final is clean on OSV).

         jackson could NOT stay on its line. CVE-2026-54512 and CVE-2026-54513 (both 8.1,
         PolymorphicTypeValidator bypasses) are fixed only in 2.18.8, 2.21.4 and 3.1.4 - the 2.19.x
         and 2.20.x branches were closed without a patch, so 2.19.4 is a dead end and every 2.19/2.20
         release stays vulnerable forever. 2.22.x is the current maintained 2.x line and OSV reports
         it clean. Boot 3.5.16 moved its own managed jackson to 2.21.4, which is NOT clean either
         (CVE-2026-54515, CVE-2026-59889), so this override still has to win. Jackson holds binary
         compatibility across 2.x, so Spring Boot 3.5.16 runs on it. -->
    <jackson-bom.version>2.22.2</jackson-bom.version>
    <netty.version>4.1.137.Final</netty.version>
    <!-- Boot 3.5.16 still manages log4j2 2.24.3, which log4j-to-slf4j drags in via
         spring-boot-starter-logging. 2.24.3 is flagged for CVE-2026-34477, CVE-2026-34479 and
         CVE-2026-49844 - all below the failBuildOnCVSS=7 gate, so this is hygiene rather than a
         blocker, but it costs nothing while the tree is open. Only the log4j API/bridge is on the
         classpath (logback is the actual backend), so the blast radius of the bump is small. -->
    <log4j2.version>2.26.1</log4j2.version>

    <!-- ===== transitive pins for the cassyx-bulk Parquet/Hadoop tree =====
         These artifacts are not declared anywhere; they arrive under parquet-avro and
         hadoop-common (see cassyx-bulk/pom.xml) at versions Hadoop 3.4.x froze years ago. Pinned
         here rather than in cassyx-bulk so the whole reactor gets one answer.
         guava                27.0-jre  -> CVE-2023-2976 (7.1) and CVE-2020-8908, both fixed in
                                          32.0.0; taking the current 33.7.1-jre.
         commons-beanutils    1.9.4     -> CVE-2025-48734 (8.8), fixed in 1.11.0. It arrived under
                                          commons-configuration2, which at 2.15.1 no longer depends
                                          on it, so this pin currently resolves nothing; kept as a
                                          floor in case anything reintroduces it.
         commons-lang3        3.17.0    -> CVE-2025-48924, fixed in 3.18.0; taking 3.20.0.
         commons-configuration2 2.10.1  -> CVE-2026-45205, fixed in 2.15.0; taking 2.15.1.
         aircompressor        2.0.2     -> CVE-2025-67721 (6.3, under the gate), fixed in 2.0.3.
         Every one of these versions was checked against OSV and reports zero known vulns. -->
    <guava.version>33.7.1-jre</guava.version>
    <commons-beanutils.version>1.11.0</commons-beanutils.version>
    <commons-lang3.version>3.20.0</commons-lang3.version>
    <commons-configuration2.version>2.15.1</commons-configuration2.version>
    <aircompressor.version>2.0.3</aircompressor.version>

    <!-- tooling -->
    <junit.version>5.11.4</junit.version>
    <mockito.version>5.14.2</mockito.version>
    <archunit.version>1.3.0</archunit.version>
    <testcontainers.version>1.20.4</testcontainers.version>
    <slf4j.version>2.0.16</slf4j.version>
    <jacoco.version>0.8.12</jacoco.version>
    <pitest.version>1.17.4</pitest.version>
    <pitest-junit5.version>1.2.2</pitest-junit5.version>
    <!-- Must match the junit-platform version Spring Boot's BOM resolves, otherwise PIT's minion
         dies with "OutputDirectoryProvider not available". -->
    <junit-platform.version>1.12.2</junit-platform.version>
    <spotless.version>2.44.3</spotless.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <checkstyle.version>10.21.1</checkstyle.version>
    <!-- Pinned so `make cve-scan` always runs the same analyser; see the plugin block below. -->
    <dependency-check.version>13.0.0</dependency-check.version>
    <surefire.version>3.5.2</surefire.version>
    <failsafe.version>3.5.2</failsafe.version>
    <!-- Minimum Engine API Docker 29 accepts; see the surefire/failsafe config below. -->
    <docker.api.version>1.44</docker.api.version>

    <checkstyle.config.path>${project.basedir}/config/checkstyle.xml</checkstyle.config.path>

    <!-- ===== JaCoCo coverage gates: docs/plan.md section 11.1 =====
         Each module overrides cassyx.coverage.line with its own gate:
             cassyx-core 0.85 | cassyx-bulk 0.85 | cassyx-vector 0.80
             cassyx-license 0.90 | cassyx-migrate 0.75 | cassyx-api 0.60
         jacoco:check IS bound to `verify`, so once enabled the build FAILS under threshold.

         PHASE 0 NOTE - READ BEFORE CHANGING:
         The modules are skeletons right now; enforcing 85% against near-empty jars would block
         every Phase 1 agent on day one for no safety benefit. So the check execution is skipped
         by default via cassyx.coverage.skip=true. The report goal always runs, so coverage numbers
         are still produced and visible.
         PHASE 1 AGENTS: flip this to false (here, or per module, or with -Dcassyx.coverage.skip=false)
         as soon as your module has real logic. It must be false before v1 ships. -->
    <cassyx.coverage.skip>true</cassyx.coverage.skip>
    <cassyx.coverage.line>0.60</cassyx.coverage.line>
    <!-- PIT mutation-score gate; target is 70 (plan section 11.1). See the pitest configuration. -->
    <cassyx.mutation.threshold>0</cassyx.mutation.threshold>

    <!-- Integration tests (*IT, Testcontainers Cassandra 5.x) are opt-in: `mvn verify` stays green
         on a machine without a Docker socket, and the CI `integration` job runs
         `mvn verify -Dcassyx.it=true`. See io.cassyx.core.testsupport.IntegrationTestBase. -->
    <cassyx.it>false</cassyx.it>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Security overrides come FIRST: nearest-wins in dependencyManagement is
           first-declaration-wins, so these beat anything the imported BOMs manage. -->
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>

      <!-- Transitive pins for the Parquet/Hadoop tree (rationale on the properties above). Direct
           <dependencyManagement> entries in this first block, not properties, because Hadoop pins
           these in its OWN poms - a property here would never be consulted. -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-beanutils</groupId>
        <artifactId>commons-beanutils</artifactId>
        <version>${commons-beanutils.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>${commons-lang3.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-configuration2</artifactId>
        <version>${commons-configuration2.version}</version>
      </dependency>
      <dependency>
        <groupId>io.airlift</groupId>
        <artifactId>aircompressor</artifactId>
        <version>${aircompressor.version}</version>
      </dependency>

      <!-- DSBulk (section 5.3). Managed but deliberately NOT a compile dependency of any module:
           DSBulk's application.conf collides with Spring/Typesafe Config on one classpath, so the
           runner is executed out-of-process from the distribution shipped in the Docker image.
           The pin lives here so that if any module ever does add it, it inherits the CVE overrides
           above rather than DSBulk's own transitive logback/assertj. -->
      <dependency>
        <groupId>com.datastax.oss</groupId>
        <artifactId>dsbulk-runner</artifactId>
        <version>${dsbulk.version}</version>
      </dependency>

      <!-- MUST be imported BEFORE spring-boot-dependencies. Spring Boot's BOM manages
           org.apache.cassandra:java-driver-core itself via <cassandra-driver.version>,
           and for IMPORTED boms it is first-declaration-wins - overriding the property in this POM
           does nothing, because the property is resolved inside the imported BOM, not here.
           Declared after Spring Boot, this BOM was silently ignored: the property said 4.19.3 while
           `dependency:tree` still resolved 4.19.0. Verified with dependency:tree, not by reading. -->
      <dependency>
        <groupId>org.apache.cassandra</groupId>
        <artifactId>java-driver-bom</artifactId>
        <version>${java-driver.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Security BOMs, imported BEFORE Spring Boot's for the first-declaration-wins reason
           documented on java-driver-bom above. Spring Boot 3.5.16 manages jackson-bom 2.21.4 and
           netty 4.1.135.Final; declared after it, these would be silently ignored. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Same first-declaration-wins reason: Spring Boot's BOM resolves log4j2.version internally,
           so the property above only takes effect because this BOM is imported ahead of it. -->
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>${log4j2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Embedded Tomcat, pinned ahead of Spring Boot's BOM for the same first-declaration-wins
           reason as the BOMs above. There is no tomcat-bom, and setting <tomcat.version> does
           NOT work here: that property is only honoured when spring-boot-starter-parent is the
           real parent POM. With an imported BOM the property is resolved inside the BOM, so the
           override is silently ignored - confirmed by dependency:tree still reporting 10.1.55
           after the property was set. All three artifacts must be listed; managing only -core
           would leave -el and -websocket behind at Boot's version. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.stripe</groupId>
        <artifactId>stripe-java</artifactId>
        <version>${stripe.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>

      <dependency>
        <groupId>io.cassyx</groupId>
        <artifactId>cassyx-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cassyx</groupId>
        <artifactId>cassyx-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>io.cassyx</groupId>
        <artifactId>cassyx-bulk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cassyx</groupId>
        <artifactId>cassyx-vector</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cassyx</groupId>
        <artifactId>cassyx-migrate</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cassyx</groupId>
        <artifactId>cassyx-license</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          Docker 29's daemon rejects Engine API versions below 1.44, but the docker-java
          client bundled with Testcontainers 1.21 negotiates lower and fails with the
          thoroughly misleading "Could not find a valid Docker environment" - which reads
          like Docker is not installed rather than a version handshake failure.

          Pinning api.version here rather than leaving it to each module: three separate
          workstreams hit this independently and each invented its own local workaround,
          and it would otherwise fail the CI `integration` job for everyone.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <systemPropertyVariables>
              <api.version>${docker.api.version}</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe.version}</version>
          <configuration>
            <systemPropertyVariables>
              <api.version>${docker.api.version}</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5.version}</version>
            </dependency>
            <dependency>
              <groupId>org.junit.platform</groupId>
              <artifactId>junit-platform-launcher</artifactId>
              <version>${junit-platform.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <targetClasses>
              <param>io.cassyx.*</param>
            </targetClasses>
            <targetTests>
              <param>io.cassyx.*</param>
            </targetTests>
            <!-- section 11.1: 70% mutation-score gate on core + bulk. Same Phase 0 deal as the
                 JaCoCo gates: the target is 70, but the skeleton scores ~56% because the
                 driver-facing classes are covered by Testcontainers integration tests rather than
                 unit tests. Phase 1 agents flip cassyx.mutation.threshold to 70 alongside
                 cassyx.coverage.skip=false; the nightly CI mutation job passes
                 -Dcassyx.mutation.threshold=70 to see the real number. -->
            <mutationThreshold>${cassyx.mutation.threshold}</mutationThreshold>
            <timestampedReports>false</timestampedReports>
            <outputFormats>
              <param>HTML</param>
              <param>XML</param>
            </outputFormats>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- OWASP Dependency-Check. NO execution is bound: the scan is invoked as a standalone goal
           from `make cve-scan` / the weekly workflow (org.owasp:dependency-check-maven:aggregate),
           never from the per-commit lifecycle - a full NVD sync takes over an hour. Declaring the
           plugin here is still what makes that CLI invocation deterministic: it fixes the plugin
           version (otherwise Maven silently resolves whatever is newest on Central) and, more
           importantly, applies the suppression file, which a CLI invocation would otherwise not
           know about.

           maven.multiModuleProjectDirectory (not project.basedir) so the path resolves to
           backend/ for the aggregate run at the reactor root AND for any per-module invocation. -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>${dependency-check.version}</version>
        <configuration>
          <suppressionFiles>
            <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
          </suppressionFiles>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <importOrder/>
            <removeUnusedImports>
              <engine>cleanthat-javaparser-unnecessaryimport</engine>
            </removeUnusedImports>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <!-- `apply` in the local build keeps sources canonical; CI additionally runs
                 `mvn spotless:check` in the lint job, which then trivially passes. -->
            <id>spotless-apply</id>
            <phase>process-sources</phase>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${checkstyle.config.path}</configLocation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-validate</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <!-- Bound to `verify`: the build fails under threshold once the skip flag is off. -->
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${cassyx.coverage.skip}</skip>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cassyx.coverage.line}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
