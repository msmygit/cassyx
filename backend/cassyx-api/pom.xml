<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cassyx</groupId>
    <artifactId>cassyx-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>cassyx-api</artifactId>
  <name>cassyx-api</name>
  <description>Spring Boot application: REST/SSE adapters and bean wiring. The ONLY module allowed to depend on Spring.</description>

  <properties>
    <checkstyle.config.path>${project.parent.basedir}/config/checkstyle.xml</checkstyle.config.path>
    <!-- section 11.1 gate: 60% - thin adapters, covered by integration + E2E instead. -->
    <cassyx.coverage.line>0.60</cassyx.coverage.line>
    <!-- Baked into application.yml at package time (plan section 9.2). Declared here as well as in
         the profiles below so the property always resolves, even when some unrelated profile is
         activated on the command line and deactivates `dev`. -->
    <cassyx.license.bypass.allowed>true</cassyx.license.bypass.allowed>
  </properties>

  <profiles>
    <!--
      Plan section 9.2. CASSYX_LICENSE_ENFORCE=false is documented, so anyone who reads the README
      can unlock the paid product with one env var, and nothing in the code can tell our own CI from
      a customer who read the docs. The switch has real uses, so it is not deleted - it is gated at
      BUILD time here, and the legitimate users get a free signed `site` licence instead.
    -->
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <cassyx.license.bypass.allowed>true</cassyx.license.bypass.allowed>
      </properties>
    </profile>
    <!-- Used by backend/Dockerfile, i.e. by every published image. -->
    <profile>
      <id>release</id>
      <properties>
        <cassyx.license.bypass.allowed>false</cassyx.license.bypass.allowed>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-bulk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-vector</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-migrate</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-license</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ArchUnit sees every cassyx class because this module depends on all of them, which is why
         the architecture test lives here. It runs in the default build (mvn test). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The shared Testcontainers Cassandra 5.x singleton (section 11.2). -->
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>cassandra</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Only application.yml is filtered, and only on the @...@ delimiter: the file is full of
         ${CASSYX_*} Spring placeholders, and the default ${...} delimiter would put Maven and
         Spring in competition for them. Everything else (Flyway migrations especially) is copied
         byte-for-byte. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>application.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>application.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <!-- Pinned rather than inherited from the Maven distribution: the filtering below decides
             whether the shipped image honours the licence bypass, so it must not vary with the
             Maven version that happens to build the image. -->
        <version>3.3.1</version>
        <configuration>
          <useDefaultDelimiters>false</useDefaultDelimiters>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
              <!-- Writes META-INF/build-info.properties, which Boot exposes as a BuildProperties
                   bean. That is the source of truth for io.cassyx.api.config.CassyxVersion, and
                   therefore for the major version the licence gate uses to decide UPGRADE_REQUIRED
                   (plan section 9.5). Chosen over resource filtering because it needs no filtering
                   configuration and does not compete with the @-delimited filtering application.yml
                   already uses for cassyx.license.bypass-allowed. -->
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Failsafe defaults to the module's ARTIFACT, and spring-boot:repackage has by then
               rewritten that jar into a fat jar whose classes live under BOOT-INF/classes. An
               integration test that touches any cassyx-api class then dies during discovery with
               NoClassDefFoundError. Point Failsafe at the plain output directory instead. -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          <systemPropertyVariables>
            <!-- Opt-in; pass -Dcassyx.it=true to run against the shared Cassandra container. -->
            <cassyx.it>${cassyx.it}</cassyx.it>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
