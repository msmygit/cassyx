<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cassyx</groupId>
    <artifactId>cassyx-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>cassyx-vector</artifactId>
  <name>cassyx-vector</name>
  <description>SAI / vector / ANN services. Plain Java, no Spring.</description>

  <properties>
    <checkstyle.config.path>${project.parent.basedir}/config/checkstyle.xml</checkstyle.config.path>
    <!-- section 11.1 gate -->
    <cassyx.coverage.line>0.80</cassyx.coverage.line>
    <!-- Workstream F: this module has real logic and meets the section 11.1 gate, so the
         Phase 0 escape hatch is off here. Do not put it back. -->
    <cassyx.coverage.skip>false</cassyx.coverage.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- The shared Testcontainers Cassandra 5.x singleton (section 11.2). Vector + SAI need 5.x. -->
    <dependency>
      <groupId>io.cassyx</groupId>
      <artifactId>cassyx-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>cassandra</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Opt-in; pass -Dcassyx.it=true to run against the shared Cassandra container. -->
            <cassyx.it>${cassyx.it}</cassyx.it>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
