# Base URL of the cassyx-api backend. Empty string = same-origin (the nginx image proxies /api).
VITE_CASSYX_API_BASE_URL=

# Request timeout in milliseconds for non-streaming API calls.
VITE_CASSYX_API_TIMEOUT_MS=30000

# Dev-only: where `vite dev` proxies /api to.
CASSYX_API_PROXY=http://localhost:8080

# Set true when running Vite inside Docker on a bind-mounted volume (HMR file watching).
CASSYX_POLL_WATCH=false
